<?xml version="1.0"?>
<!--
  Gazebo world for the marker pick: a stand whose top is at z = 0.35, a white 50 x 140 x 50 mm box
  carrying ArUco tag 1 (57 mm) centred on its top face, and ArUco tag 0 (75.7 mm) lying on the stand
  as the destination.  @TEX@ is replaced by the texture directory at launch (gazebo_pick.launch.py).
  The tags are thin visual plates (no collision) so only the TOP face shows a marker - a textured box
  would show the marker on its sides too, and the chest camera would see those as tilted tags.
-->
<sdf version="1.8">
  <world name="openarm_pick">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0.3 0.3 1.5 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>5</range><constant>0.6</constant><linear>0.1</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- stand: 0.50 x 1.00 x 0.35, x from 0.15 to 0.65, top at z = 0.35 (the hanging arm clears it) -->
    <model name="stand">
      <static>true</static>
      <pose>0.40 0 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.50 1.00 0.35</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 1.00 0.35</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- destination: tag 0 on a 100 mm plate lying on the stand -->
    <model name="place_tag">
      <static>true</static>
      <!-- on the right arm's side (y < 0): the right arm has no vertical-hand IK at y > 0 -->
      <!-- y = -0.25 was cut off at the right edge of the chest image -->
      <pose>0.29 -0.22 0.3505 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.100 0.100 0.001</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal><albedo_map>@TEX@/aruco_0.png</albedo_map><metalness>0</metalness><roughness>1</roughness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- the object: white 50 x 140 x 50 mm box, long side along Y, tag 1 (75 mm plate) centred on top -->
    <model name="box">
      <!-- 10 cm clear of the destination tag: at y=-0.10 the box hid part of tag 0 from the chest camera -->
      <pose>0.32 -0.08 0.375 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>9.2e-5</ixx><iyy>2.1e-5</iyy><izz>9.2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.14 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.14 0.05</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <visual name="tag">
          <pose>0 0 0.0255 0 0 @TAG_YAW@</pose>
          <geometry><box><size>0.075 0.075 0.001</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal><albedo_map>@TEX@/aruco_1.png</albedo_map><metalness>0</metalness><roughness>1</roughness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
