<?xml version="1.0"?>
<package format="3">
  <name>openarm_vision_pick</name>
  <version>0.1.0</version>
  <description>Wrist-camera colour+depth object detection and MoveIt pick-and-place
  for the OpenArm left arm. The same nodes run against Gazebo and against the
  real D405; only the topic names and the gripper joint list differ.</description>
  <maintainer email="roboticsmaster@naver.com">Seongmin</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <exec_depend>python3-scipy</exec_depend>

  <exec_depend>std_srvs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>openarm_bringup</exec_depend>
  <exec_depend>openarm_bimanual_moveit_config</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rviz2</exec_depend>
</package>
